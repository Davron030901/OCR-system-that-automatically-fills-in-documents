# ─── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Data stores ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ocr:ocr@localhost:5432/ocr
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ocr-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ─── Internal services ────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8100
CONVERTER_URL=http://localhost:8200
INTERNAL_TOKEN=generate-a-random-value

# ─── Crypto ───────────────────────────────────────────────────────────────
# Extracted passport data is stored encrypted. Generate with:
#   python -c "from app.security.crypto import generate_key; print(generate_key())"
# The API refuses to start in production without this.
ENCRYPTION_KEY=
JWT_SECRET=generate-a-random-value

# ─── LLM providers ────────────────────────────────────────────────────────
# PAID key. Cleared for real personal data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIER=paid

# FREE Gemini keys, comma-separated. SYNTHETIC DATA ONLY.
# Free-tier submissions may be used to improve the provider's models, so the
# PII gate refuses to send real documents here. Use these for prompt tuning
# and evaluation against training/00_synthetic_data.ipynb output.
GEMINI_FREE_KEYS=

# PAID Gemini keys (billing enabled). Set GEMINI_PAID_ENABLED=true only after
# confirming the tier's data-retention terms.
GEMINI_PAID_KEYS=
GEMINI_PAID_ENABLED=false

# Locally hosted vision model. Nothing leaves your infrastructure, so this is
# the migration path if data localisation is enforced strictly.
LOCAL_VLM_URL=
LOCAL_VLM_MODEL=qwen2.5-vl-7b

LLM_ENABLED=true
LLM_PROVIDER_ORDER=local,openai,gemini-paid,gemini-free
LLM_DAILY_BUDGET_USD=5.0

# Stage L3 sends the document IMAGE off-premises. Off by default: that should
# be a deliberate decision, not a default.
ENABLE_L3_VISION=false

# ─── Features ─────────────────────────────────────────────────────────────
ENABLE_PDF_OUTPUT=true

# ─── Retention ────────────────────────────────────────────────────────────
UPLOAD_TTL_HOURS=24
EXTRACTION_TTL_DAYS=30
DOCUMENT_TTL_DAYS=90

CORS_ORIGINS=http://localhost:3000
