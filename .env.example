# Copy to .env and fill in. `make env` generates the secrets for you.
#
# ⚠️ THIS FILE IS COMMITTED TO GIT. Never put a real key in it. Real values
#    belong in .env, which .gitignore excludes.

# ─── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Data stores ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ocr:ocr@localhost:5432/ocr
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ocr-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ─── Internal services ────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8100
CONVERTER_URL=http://localhost:8200
# Shared secret between api, ml-service and converter. `make env` fills it in.
INTERNAL_TOKEN=replace-me

# ─── Crypto ───────────────────────────────────────────────────────────────
# Extracted passport data is stored encrypted. Generate with:
#   make keys
# The API refuses to start in production without this.
ENCRYPTION_KEY=replace-me
JWT_SECRET=replace-me

# ─── LLM providers ────────────────────────────────────────────────────────
# PAID key. Cleared for real personal data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIER=paid
# Set true only with a zero-data-retention agreement in place.
OPENAI_ZDR=false

# FREE Gemini keys, comma-separated. SYNTHETIC DATA ONLY.
# Free-tier submissions may be used to improve the provider's models, so the
# PII gate refuses to send real documents here. Use these for prompt tuning
# and evaluation against training/00_synthetic_data.ipynb output.
#
# ⚠️ On quantity: free-tier quota is counted per PROJECT, not per key. Ten keys
#    minted inside one project share one quota, so rotating between them gains
#    nothing. The key pool exists for failover ACROSS providers.
GEMINI_FREE_KEYS=

# PAID Gemini keys (billing enabled). These must be DIFFERENT keys from the
# free ones above — a free-tier key listed here would be treated as cleared for
# real personal data. Set GEMINI_PAID_ENABLED=true only after confirming the
# tier's data-retention terms.
GEMINI_PAID_KEYS=
GEMINI_PAID_ENABLED=false

# Locally hosted vision model. Nothing leaves your infrastructure, so this is
# the migration path if data localisation is enforced strictly.
LOCAL_VLM_URL=
LOCAL_VLM_MODEL=qwen2.5-vl-7b

LLM_ENABLED=true
LLM_PROVIDER_ORDER=local,openai,gemini-paid,gemini-free
LLM_DAILY_BUDGET_USD=5.0

# Stage L3 sends the document IMAGE off-premises. Off by default: that should
# be a deliberate decision, not a default.
ENABLE_L3_VISION=false

# ─── LLM response cache ───────────────────────────────────────────────────
# Cached model output is personal data, so it is encrypted at rest, expires on
# a strict TTL and is keyed per tenant. Falls back to an in-process cache when
# REDIS_URL is unset. With no key here it reuses ENCRYPTION_KEY; in production
# it refuses to run unencrypted at all.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=604800
LLM_CACHE_KEY=

# Pin a prompt version to hold a rollout while a new one is evaluated, e.g.
# PROMPT_PIN_ID_VISUAL_ZONE=1. Unset means "use the highest version present".
# PROMPT_PIN_ID_VISUAL_ZONE=

# ─── Document classifier (optional) ───────────────────────────────────────
# Train with training/01_classifier.ipynb on a Colab T4, then point this at the
# exported ONNX file. Unset means the classifier is disabled: the pipeline still
# extracts, it just cannot refuse an unrecognised photo up front.
# The two thresholds are printed by the notebook's calibration cell — recompute
# them every time the model is retrained.
CLASSIFIER_MODEL_PATH=
CLASSIFIER_MIN_CONFIDENCE=0.60
CLASSIFIER_MAX_ENERGY=-2.0

# ─── Features ─────────────────────────────────────────────────────────────
ENABLE_PDF_OUTPUT=true

# ─── Retention ────────────────────────────────────────────────────────────
UPLOAD_TTL_HOURS=24
EXTRACTION_TTL_DAYS=30
DOCUMENT_TTL_DAYS=90

CORS_ORIGINS=http://localhost:3000
