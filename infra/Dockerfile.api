FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /srv
COPY requirements/api.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY packages ./packages
COPY apps/api ./apps/api

# No LibreOffice here on purpose: it is ~400 MB and this container never needs
# it. Conversion lives in its own service.
RUN useradd -m -u 10001 appuser && chown -R appuser /srv
USER appuser

ENV PYTHONPATH=/srv:/srv/apps/api
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/healthz')"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "apps/api"]
